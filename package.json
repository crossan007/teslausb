{
  "name": "teslausb",
  "version": "2.0.0-alpha.0",
  "description": "TeslaUSB v2.0: TypeScript monorepo for Raspberry Pi dashcam archiving",
  "type": "module",
  "packageManager": "pnpm@8.0.0",
  "scripts": {
    "build": "tsc",
    "dev": "node --loader tsx ./src/orchestrator/index.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "tsx": "^4.10.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
